{
  // 仓库里所有 TypeScript 一份配置搞定：CLI 源码（src/）、开发脚本（scripts/）
  // 和构建配置（tsup.config.ts）都在这一个 program 里，编辑器与 CI 走的是同一套规则。
  "compilerOptions": {
    // 编译后的 JavaScript 目标版本。
    "target": "ES2020",

    // 按 CommonJS 语义检查：tsup 产出 CJS，scripts/ 也由 tsx 按 package.json 的
    // "type": "commonjs" 转成 CJS 执行，所以全仓库都不该出现 import.meta。
    "module": "CommonJS",

    // 使用 Node 的模块解析规则查找依赖。
    "moduleResolution": "Node",

    // 告诉 TS 代码运行时可用的标准库能力。
    "lib": ["ES2020"],

    // 只做类型检查：打包交给 tsup，所以不需要 rootDir / outDir，
    // 也就不会出现「文件在 rootDir(src) 之外」的 TS6059。
    "noEmit": true,

    // 允许更自然地导入 CommonJS 模块。
    "esModuleInterop": true,

    // 强制文件路径大小写一致，避免跨平台问题。
    "forceConsistentCasingInFileNames": true,

    // 开启严格模式，尽量在编译期发现类型问题。
    "strict": true,

    // 跳过第三方声明文件检查，加快类型检查速度。
    "skipLibCheck": true,

    // 允许导入 JSON 文件。
    "resolveJsonModule": true,

    // 显式引入 Node 的类型声明，如 process、__dirname 等。
    "types": ["node"]
  },

  // 三块源码都进来，编辑器按「最近的 tsconfig.json」认领文件，脚本与构建配置不会掉队。
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tsup.config.ts"],

  // 这些目录不会参与编译或类型检查。
  "exclude": ["dist", "node_modules", ".agents"]
}
