# 依赖与构建产物：dist 写成全局匹配，因为每个子包都会产出自己的 dist。
node_modules/
dist/
build/

# 本地环境变量
.env
.env.*

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器与 IDE 的本地配置
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统生成的杂项文件
.DS_Store
Thumbs.db

# TypeScript 增量编译信息，每台机器都会变，不应入库
*.tsbuildinfo

# 测试覆盖率与本地缓存
coverage/
*.local
*.cache
*.tmp

# 避免把嵌套仓库的 .git 目录提交进来
.git/
